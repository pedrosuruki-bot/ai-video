# Required for AI storyboard, images and narration.
OPENAI_API_KEY=

# Text/storyboard model used by /api/analyze.
OPENAI_MODEL=gpt-6-luna

# Speech generation.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Image generation.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Optional stock search route kept for legacy integrations.
PEXELS_API_KEY=

# Optional cloud MP4 renderer. Not required for CapCut ZIP export.
CREATOMATE_API_KEY=
CREATOMATE_VOICE_PROVIDER=
